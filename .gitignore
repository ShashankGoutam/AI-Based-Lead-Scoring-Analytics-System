cat > .gitignore << 'EOF'
# Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Node Modules
node_modules/
frontend/node_modules/
.npm
npm-debug.log*

# Cache
.cache/
*.cache

# Database
*.db
*.sqlite
*.sqlite3
lead_predictions.db
backend/lead_predictions.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Logs
*.log
logs/

# Data
data/bank-full.csv
EOF